# Kopieren nach .env und anpassen. Die .env gehört NICHT ins Git (steht in .gitignore).

# --- Ollama ---
# Standard: der Ollama-Container im Stack (http://ollama:11434), dann nichts eintragen.
# Nur für einen externen Ollama setzen, dann die IP des Hosts nehmen (aus einem Container ist "localhost" der Container selbst):
# OLLAMA_BASE_URL=http://192.168.178.64:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:Q8_0
# Kontextfenster des Sprachmodells (Tokens). Mehr braucht mehr RAM.
OLLAMA_NUM_CTX=6144
# Für qwen3 & Co.: false schaltet den Denkmodus ab. Bei llama3.x leer lassen.
OLLAMA_REASONING=
# Wie lange Ollama die Modelle nach der letzten Anfrage im RAM hält
OLLAMA_KEEP_ALIVE=24h
# So viele der letzten Nachrichten bekommt das Modell als Gesprächskontext
HISTORY_MAX_MESSAGES=6
# Auf schwacher CPU kann das Reranking die Antwort spürbar verlangsamen: false schaltet es ab.
RERANK_ENABLED=true

# --- Paperless-ngx ---
PAPERLESS_URL=http://192.168.178.64:8010
# Token eines Benutzers, der Dokumente nur ansehen darf (Paperless > Mein Profil > API-Token)
PAPERLESS_TOKEN=
# Optional: URL, unter der du Paperless im Browser öffnest (Links in den Quellen). Standard: PAPERLESS_URL
PAPERLESS_PUBLIC_URL=
# Abstand zwischen den automatischen Abgleichen
SYNC_INTERVAL_MIN=30
